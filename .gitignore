# Python
__pycache__/
*.py[cod]

# regenerable caches (built on first use by common/leech.py)
common/data/leech196560.npy

# scratch the dimension-27 self-test creates and removes
selftest-tmp/

# caches written by extract.py when it parses Cohn's coordinate file
verifications/closed/dim09-19-record-maximality/c[0-9]*.npy
verifications/closed/dim17-layered-family/scripts/c[0-9]*.npy

# LaTeX build products of the standalone dimension-27 paper (its .pdf is tracked)
verifications/improved/dim27-triple-partition/paper/*.aux
verifications/improved/dim27-triple-partition/paper/*.bbl
verifications/improved/dim27-triple-partition/paper/*.blg
verifications/improved/dim27-triple-partition/paper/*.log
verifications/improved/dim27-triple-partition/paper/*.out
verifications/improved/dim27-triple-partition/paper/*.toc
verifications/improved/dim27-triple-partition/paper/*.synctex.gz

# LaTeX build products of the manuscript.  Its .pdf and its .bbl are BOTH tracked: the .bbl
# is generated, but it is what a reviewer's build reads when bibtex is not installed, and
# without it one pdflatex pass prints [?] for all forty-five citations.  paper/*.log also
# covers build.log, and *.fdb_latexmk and *.fls carry absolute MiKTeX paths.
paper/*.aux
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls

# artefacts of in-place patching, never part of a release
*.oldcert
*.bak
*.orig
