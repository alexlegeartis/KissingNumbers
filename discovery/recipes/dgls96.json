{
  "schema_version": 1,
  "name": "dgls96",
  "description": "Published DGLS parent and two-coset union, synthesized from binary factors and independently verified. No new code claim.",
  "nodes": [
    {
      "id": "factor",
      "op": "rings.binary_factor",
      "params": {
        "n": 23,
        "index": 0
      }
    },
    {
      "id": "lift",
      "op": "rings.hensel",
      "inputs": [
        "factor"
      ],
      "params": {
        "modulus": 8
      }
    },
    {
      "id": "ring",
      "op": "rings.extend",
      "inputs": [
        "lift"
      ],
      "params": {
        "extension": -1
      }
    },
    {
      "id": "parent",
      "op": "rings.verify_dgls",
      "inputs": [
        "ring"
      ]
    },
    {
      "id": "union",
      "op": "codes.translate_union",
      "inputs": [
        "parent"
      ],
      "params": {
        "target_distance": 24
      }
    },
    {
      "id": "sphere",
      "op": "geometry.sign_embed",
      "inputs": [
        "union"
      ]
    }
  ],
  "outputs": [
    "sphere"
  ]
}
