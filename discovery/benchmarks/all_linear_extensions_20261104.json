  "source_search_script": "from pathlib import Path\nimport sys,json,time,hashlib\nimport numpy as np\nsys.path.insert(0,'/workspace/KissingNumbers/research/group_search_20261104')\nimport code_search as cs\nout=Path('/workspace/KissingNumbers/discovery/benchmarks/all_linear_extensions_20261104.json')\nstart=time.time();runs=[]\nfor fi,(g0,h0) in enumerate(cs.binary_factors(17)):\n g,h,history=cs.hensel(g0,h0,4);G=cs.generator(g,17,4)[:,:-1];k=len(G)\n labels=np.arange(4**k,dtype=np.int64)\n coefficients=((labels[:,None]//4**np.arange(k))%4).astype(np.int64)\n words=coefficients@G%4;_,weight=cs.gray(4);weights=weight[words].sum(axis=1)\n assert np.sum(weights==0)==1\n extensions=coefficients.copy();constraints=[]\n for w in (7,8):\n  for c in coefficients[weights==w]:\n   if not len(extensions):break\n   req=9-w\n   old=len(extensions);v=extensions@c%4\n   extensions=extensions[weight[v]>=req]\n   if len(extensions)<old:\n    constraints.append({'message_coefficients':c.tolist(),'base_homogeneous_weight':w,'required_extension_weight':req,'surviving_extensions':len(extensions)})\n  if not len(extensions):break\n r={'cyclic_length':17,'ring_modulus':4,'factor_index':fi,'generator_without_extension':G.tolist(),'lift_history':history,'target_binary_length':36,'target_minimum_distance':9,'extension_candidates':4**k,'base_homogeneous_histogram':np.bincount(weights,minlength=35).tolist(),'obstruction_constraints':constraints,'surviving_extensions':len(extensions),'status':'exact_restricted_family_exclusion' if not len(extensions) else 'candidates_remain','scope':'all Z4-linear single-coordinate extensions of this fixed free cyclic module; no exclusion of submodules, nonlinear extension rules, or other base modules'}\n runs.append(r);print(fi,len(constraints),len(extensions),flush=True)\n del coefficients,words\nreport={'schema_version':1,'as_of':'2026-11-04','outcome':'no SOTA; finite exact exclusion of all 4^9 linear extensions for each of two fixed base modules','elapsed_seconds':time.time()-start,'runs':runs}\nout.write_text(json.dumps(report,indent=2))\n",
  "source_replay_script": "from pathlib import Path\nfrom itertools import product\nfrom hashlib import sha256\nimport json,time\nP=Path('/workspace/KissingNumbers/discovery/benchmarks/all_linear_extensions_20261104.json');report=json.loads(P.read_text());start=time.time()\nfor r in report['runs']:\n G=r['generator_without_extension'];k=len(G);norm=lambda t:(0,1,2,1)[t%4]\n constraints=r['obstruction_constraints']\n for c in constraints:\n  coeff=c['message_coefficients'];word=[sum(coeff[i]*G[i][j] for i in range(k))%4 for j in range(17)]\n  assert sum(map(norm,word))==c['base_homogeneous_weight']\n  assert c['required_extension_weight']==9-c['base_homogeneous_weight']\n counts=[0]*len(constraints);survivors=0\n for ext in product(range(4),repeat=k):\n  for j,c in enumerate(constraints):\n   symbol=sum(a*b for a,b in zip(ext,c['message_coefficients']))%4\n   if norm(symbol)<c['required_extension_weight']:\n    counts[j]+=1;break\n  else:survivors+=1\n assert survivors==0 and sum(counts)==4**k\n r['independent_integer_replay']={'algorithm':'Python standard library product over every extension; direct integer coordinate dot products and weight tuple (0,1,2,1); no NumPy or search-module imports','extensions_checked':4**k,'survivors':survivors,'first_failing_constraint_counts':counts,'witness_weights_recomputed':True}\nreport['independent_replay_elapsed_seconds']=time.time()-start\nreport['source_search_script']=Path('/workspace/scratch/discovery_followup/search_all_extensions.py').read_text()\nreport['source_replay_script']=Path(__file__).read_text()\nreport['source_module']='research/group_search_20261104/code_search.py'\nreport['source_module_sha256']=sha256(Path('/workspace/KissingNumbers/research/group_search_20261104/code_search.py').read_bytes()).hexdigest()\nP.write_text(json.dumps(report,indent=2));print('two independent finite exclusions passed',time.time()-start)\n",
