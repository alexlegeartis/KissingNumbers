  "source_search_script": "from pathlib import Path\nimport sys, json, time, hashlib\nimport numpy as np\nsys.path.insert(0,'/workspace/KissingNumbers/research/group_search_20261104')\nimport code_search as cs\nout=Path('/workspace/KissingNumbers/discovery/benchmarks/followup_extensions_20261104.json')\nstart=time.time();runs=[]\nfor n,qs in [(11,(4,8)),(17,(4,))]:\n    factors=cs.binary_factors(n)\n    for fi,(g0,h0) in enumerate(factors):\n        for q in qs:\n            g,h,history=cs.hensel(g0,h0,q)\n            for extension in range(q):\n                G=cs.generator(g,n,q,extension=extension)\n                d,hist=cs.enumerate_small(G,q)\n                N=(n+1)*q//2\n                r={'cyclic_length':n,'factor_index':fi,'ring_modulus':q,'extension_scalar':extension,'generator':G.tolist(),'lift_history':history,'binary_length':N,'parent_cardinality':q**len(G),'minimum_distance':d,'homogeneous_weight_histogram':hist,'qualifies_as_kissing_sign_layer':4*d>=N,'proof_scope':'exhaustive module homogeneous weights; all Gray symbol pairs checked; free systematic cyclic generator proves distinctness','status':'exact_parent_distance_verified'}\n                runs.append(r)\n                print(n,q,fi,extension,N,q**len(G),d,4*d>=N,flush=True)\n                out.write_text(json.dumps({'schema_version':1,'as_of':'2026-11-04','experiment':'all scalar sum-extension choices for Hensel-lifted half-degree factors at cyclic lengths 11 and 17','outcome':'no new SOTA; compare qualifying sign layers separately against catalog','elapsed_seconds':time.time()-start,'runs':runs},indent=2))\nprint('seconds',time.time()-start,flush=True)\n",
